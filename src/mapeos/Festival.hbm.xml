<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
	<class name="datos.Festival" table="festival">
		<id column="idFestival" name="idFestival">
			<generator class="identity" />
		</id>
		
		<property column="nombre" name="nombre" type="string" />
		<property column="temporada" name="temporada" type="string" />
		<property column="fechaDeInicio" name="fechaDeInicio" type="LocalDate" />
		<property column="fechaDeFin" name="fechaDeFin" type="LocalDate" />
		
		
		<set name="platos" table="platos" order-by="idPlato asc" inverse="true" lazy="true" fetch="select">
			<key column="idFestival" not-null="true" />
			<one-to-many class="datos.Plato" />
		</set>

		
	</class>
</hibernate-mapping>