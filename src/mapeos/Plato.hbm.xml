<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
	<class name="datos.Plato" table="plato">
		<id column="idPlato" name="idPlato">
			<generator class="identity" />
		</id>
		
		<property column="nombre" name="nombre" type="string" />
		<property column="precio" name="precio" type="float"/>
		<property column="costoProduccion" name="costoProduccion" type="float"/>
		
		<many-to-one name="festival" class="datos.Festival" column="idFestival" not-null="true"/>
		
	</class>
</hibernate-mapping>